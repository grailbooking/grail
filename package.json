{
  "name": "grail-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant barbershop booking and POS platform",
  "repository": "https://github.com/yourorg/grail",
  "license": "UNLICENSED",
  "packageManager": "yarn@4.11.0",
  "workspaces": [
    "packages/web",
    "packages/widget",
    "packages/functions"
  ],
  "scripts": {
    "dev": "yarn workspace @grail/web dev",
    "build": "yarn workspaces foreach -A run build",
    "lint": "yarn workspaces foreach -A run lint",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "clean": "yarn workspaces foreach -A run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0"
  }
}
