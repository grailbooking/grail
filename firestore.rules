rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isShopOwner(shopId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/shops/$(shopId)/staff/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/shops/$(shopId)/staff/$(request.auth.uid)).data.role == 'owner';
    }

    function isShopStaff(shopId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/shops/$(shopId)/staff/$(request.auth.uid));
    }

    // Shops
    match /shops/{shopId} {
      allow read: if isAuthenticated();
      allow write: if isShopOwner(shopId);

      // Staff
      match /staff/{staffId} {
        allow read: if isShopStaff(shopId);
        allow write: if isShopOwner(shopId);
      }

      // Appointments
      match /appointments/{appointmentId} {
        allow read: if isShopStaff(shopId) || request.auth.uid == resource.data.client_id;
        allow create: if isAuthenticated();
        allow update, delete: if isShopStaff(shopId);
      }

      // Waitlist
      match /waitlist/{waitlistId} {
        allow read: if isShopStaff(shopId) || request.auth.uid == resource.data.client_id;
        allow create: if isAuthenticated();
        allow update, delete: if isShopStaff(shopId);
      }

      // Services
      match /services/{serviceId} {
        allow read: if true;
        allow write: if isShopOwner(shopId);
      }

      // Availability
      match /availability/{availabilityId} {
        allow read: if true;
        allow write: if isShopStaff(shopId);
      }
    }

    // Client profiles
    match /clients/{clientId} {
      allow read, write: if isAuthenticated() && request.auth.uid == clientId;
    }
  }
}
